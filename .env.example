# Regtest Esplora/mempool API — chain status, address balances/UTXOs, broadcast.
# Defaults to this if unset.
BTECH_ESPLORA_URL=https://btc.utxopia.com/regtest

# Long-lived vault service (DKG once, fast + stable address). Optional:
# when unset, the app falls back to spawning the Rust CLI per request.
BTECH_VAULTD_URL=http://127.0.0.1:8787

# Nostr relay for E2E chat (browser connects directly). Same relay relaychat.rs uses.
NEXT_PUBLIC_NOSTR_RELAY=ws://127.0.0.1:7777
